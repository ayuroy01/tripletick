# All optional. Triple Tick boots with no configuration.
PORT=4310
TT_DATA_DIR=./data
# Public https URL of this server. Needed for Meta webhooks and secure cookies.
TT_PUBLIC_URL=
# Seeds fictional demo data and a demo login. Never set this in production.
TT_DEMO=
# Enables Claude-powered AI. Without it, Triple Tick uses its offline helpers.
ANTHROPIC_API_KEY=
TT_AI_MODEL=claude-opus-5-5
# Encrypts stored tokens. If unset, a key file is created in the data folder.
TT_SECRET_KEY=
# JSON list of WebRTC servers for calls. Add TURN for restrictive networks.
TT_ICE_SERVERS=
# Graph API version for WhatsApp Cloud API calls.
TT_GRAPH_VERSION=v26.0
# Lets outbound webhooks reach private network addresses. Only for receivers on your own network.
TT_ALLOW_PRIVATE_WEBHOOKS=
